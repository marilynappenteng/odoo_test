<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="vehicle_creation_action" model="ir.actions.act_window">
		<field name="name">Vehicle</field>
		<field name="res_model">transport.vehicle</field>
		<field name="view_mode">list,form</field>
		<field name="context">{'search_default_pending': True}</field>
	</record>

	<record id="vehicles_view_list" model="ir.ui.view">
		<field name="name">transport.vehicle.list</field>
		<field name="model">transport.vehicle</field>
		<field name="arch" type="xml">
			<list string="Vehicles" decoration-warning="status == 'pending_approval'" decoration-success="status == 'verified'">
				<field name="vehicle_id"/>
				<field name="vehicle_reg"/>
				<field name="date_acquired"/>
				<field name="status"/>
			</list>
		</field>
	</record>

	<record id="vehicles_view_form" model="ir.ui.view">
		<field name="name">transport.vehicle.form</field>
		<field name="model">transport.vehicle</field>
		<field name="arch" type="xml">
			<form string="Vehicle">
				<header>
					<button name="action_submit_new_vehicle" type="object" string="Submit" invisible="status != 'new'" />
				</header>
				<sheet>
					<group>
						<field name="vehicle_id"/>
						<field name="assignee"/>
						<field name="assigned_employee_id" invisible="assignee == False"/>
						<field name="assigned_bu_id" invisible="assignee == True"/>
						<field name="status" readonly="1"/>
					</group>
					<group>
						<field name="vehicle_reg"/>
						<field name="make"/>
						<field name="car_model"/>
						<field name="color"/>
					</group>
					<group>
						<field name="mileage"/>
						<field name="date_acquired" readonly="status != 'new'"/>
					</group>
					<notebook>
						<page string="Files">
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="vehicle_view_search" model="ir.ui.view">
		<field name="name">transport.vehicle.search</field>
		<field name="model">transport.vehicle</field>
		<field name="arch" type="xml">
			<search string="Status Filter">
				<filter name="pending" string="Pending Approval" domain="[('status','=','pending_approval')]" help="Show vehicles created pending approvals"></filter>
				<filter name="verified" string="Verified" domain="[('status','=','verified')]" help="Show verified vehicles"></filter>
			</search>
		</field>
	</record>
</odoo>
